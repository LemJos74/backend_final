# Copia este archivo a .env para desarrollo. Completa los valores vacíos localmente.
APP_NAME=LimpiaHuancayo API
DB_HOST=localhost
DB_PORT=5432
DB_NAME=limpiahuancayo
DB_USER=limpiahuancayo_app
DB_PASSWORD=
DB_SSLMODE=prefer
# En Supabase, usa verify-full y la ruta al certificado CA.
DB_SSLROOTCERT=
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=30
# Vacío con el proxy de Angular. En Render, usa orígenes HTTPS separados por comas.
CORS_ORIGINS=
REPORTES_FOTOS_DIR=storage/reportes
